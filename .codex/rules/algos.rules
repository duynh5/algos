# Repository-local standing authorizations requested by the user on
# 2026-10-17.
prefix_rule(
    pattern = ["git", "mv"],
    decision = "allow",
    justification = (
        "The user authorized tracked-file renames in the algos " +
        "repository."
    ),
    match = [
        "git mv problems/easy_leetcode_0070_climbing_stairs.go " +
        "problems/solved_easy_leetcode_0070_climbing_stairs.go",
        "git mv old_name.go new_name.go",
    ],
    not_match = [
        "mv old_name.go new_name.go",
        "git add .",
        "git reset --hard",
    ],
)

prefix_rule(
    pattern = ["go", "test"],
    decision = "allow",
    justification = (
        "The user authorized Go test execution in the algos " +
        "repository."
    ),
    match = [
        "go test ./...",
        "go test ./internal/testrunner",
        "go test -run TestConfiguredSamplesAgainstEverySolution " +
        "./workbench",
    ],
    not_match = [
        "go vet ./...",
        "go env -w GOPROXY=direct",
        "git test ./...",
    ],
)
